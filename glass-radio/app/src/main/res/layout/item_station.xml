<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/station_card_width"
    android:layout_height="@dimen/station_card_height"
    android:layout_margin="@dimen/station_card_margin"
    android:background="@drawable/bg_station_card"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/station_card_padding">

    <TextView
        android:id="@+id/station_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/station_name_size"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/station_genre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/station_genre_size" />

    <TextView
        android:id="@+id/playing_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="▶ PLAYING"
        android:textColor="@color/status_playing"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
